# Supabase project. Get these from https://app.supabase.com/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated emails allowed into the admin (per PLAN.md D15: one operator).
# Example: ADMIN_ALLOWED_EMAILS=robin@vidfolio.kr
ADMIN_ALLOWED_EMAILS=

# Base URL the magic-link callback redirects to. Use the public site URL in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
